{"nodes": [{"id": "readme_project", "label": "Ochoa Real Estate Services Platform", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_architecture_topology", "label": "Deployment Architecture (Local/Staging/Production)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_filament_admin_panel", "label": "Filament Admin Panel", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_git_workflow", "label": "Git Workflow (main=production, develop=staging)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_env_files", "label": "Environment Files Reference", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_refresh_staging_script", "label": "refresh-staging.sh Script", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fastcgi_pass_container_naming", "label": "Explicit Container Names Required for fastcgi_pass", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docker DNS can resolve a generic hostname like app:9000 to either the prod or staging PHP-FPM container when both share a network, causing random cross-contamination (wrong session cookies, mismatched Livewire asset hashes, intermittent 404s). Explicit container names (ochoa2_app:9000, ochoa2_staging_app:9000) avoid this ambiguity."}, {"id": "readme_config_cache_bug", "label": "Do Not Run php artisan config:cache in Production", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With the current Livewire/Filament version combination, config:cache has caused the served HTML's Livewire asset hash to diverge from the cached route table, breaking the admin login flow. route:cache and view:cache remain safe."}, {"id": "readme_filamentuser_contract", "label": "User Model Must Implement FilamentUser Contract", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filament\\Models\\Contracts\\FilamentUser with canAccessPanel() must be implemented on the User model because Filament blocks panel access by default outside the local environment without it."}, {"id": "readme_trustproxies_middleware", "label": "trustProxies Middleware Configuration", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without $middleware->trustProxies(at: '*') in bootstrap/app.php, Laravel doesn't trust the X-Forwarded-Proto header from Nginx Proxy Manager and generates http:// URLs even when served over HTTPS, causing mixed-content browser errors."}, {"id": "readme_fileupload_disk_public", "label": "Filament FileUpload Must Set disk(\"public\")", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Laravel's default local disk root changed in recent versions; without explicitly setting ->disk(\"public\") on Filament FileUpload components, uploads can silently land in a non-web-accessible location."}, {"id": "readme_opcache_settings", "label": "OPcache Dev Settings (validate_timestamps/revalidate_freq)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Dockerfile sets opcache.validate_timestamps=1 and revalidate_freq=0 for dev so file changes are picked up immediately; if stale-code symptoms appear after a deploy, docker compose restart app forces a clean reload."}, {"id": "readme_shared_nginx_conf_bug", "label": "Shared nginx default.conf Across Environments", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "docker/nginx/default.conf is shared across local dev, staging, and production; editing it for one environment can silently break another. If a server-specific fastcgi_pass value leaks onto develop/main and is pulled onto a fresh dev machine, ochoa2_web crash-loops with 'host not found in upstream'. TODO: split into environment-specific nginx configs mounted directly on servers, not committed shared files."}, {"id": "readme_nginx_conf_mount_error", "label": "Docker \"not a directory\" Mount Error for default.conf", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When docker/nginx/default.conf doesn't exist locally (e.g. after pulling a commit that removed it from git tracking), Docker auto-creates an empty directory in its place, causing a 'not a directory' mount error. Fix: remove the auto-created directory with sudo and copy default.conf.example to default.conf."}, {"id": "readme_nginx_default_conf", "label": "docker/nginx/default.conf (Shared Nginx Config)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ochoa2_staging_app", "label": "ochoa2_staging_app Container (Staging PHP-FPM)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_project", "target": "readme_architecture_topology", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_project", "target": "readme_filament_admin_panel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_project", "target": "readme_git_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_project", "target": "readme_env_files", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_project", "target": "readme_refresh_staging_script", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_project", "target": "src_readme_laravel_framework", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_architecture_topology", "target": "readme_fastcgi_pass_container_naming", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_project", "target": "readme_fastcgi_pass_container_naming", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": n